<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CherryPick"
        Width="800" Height="600"
        ResizeMode="NoResize" SizeToContent="Height">
    <Grid>
        <TabControl Margin="5" Height="560" Width="780">
            <TabItem Header="Parameter">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Controls row -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>
                    <!-- Controls row -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5" HorizontalAlignment="Left">
                        <Button Content="Add Parameter" Width="120" Height="24" Margin="2" Click="AddParameter_Click"/>
                        <ComboBox x:Name="ImportExportComboBox"
                                Width="120"
                                Height="24"
                                Margin="2"
                                IsEditable="True"
                                IsReadOnly="True"
                                Text="Import/Export"
                                SelectedIndex="-1">
                            <ComboBoxItem Content="Import"/>
                            <ComboBoxItem Content="Export"/>
                        </ComboBox>
                        <ComboBox x:Name="BatchActionComboBox"
                                Width="120"
                                Height="24"
                                Margin="2"
                                IsEditable="True"
                                IsReadOnly="True"
                                Text="Batch Action"
                                SelectedIndex="-1">
                            <ComboBoxItem Content="Duplicate Parameters"/>
                            <ComboBoxItem Content="Delete Parameters"/>
                        </ComboBox>
                        <!-- <ComboBox x:Name="ParameterTypeFilterComboBox" Width="160" Margin="5" 
                                SelectionChanged="ParameterTypeFilterComboBox_SelectionChanged"
                                Text="Parameter Type Filter"
                                IsEditable="True"
                                IsReadOnly="True"
                                SelectedIndex="-1">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Project Parameter"/>
                            <ComboBoxItem Content="Shared Parameter"/>
                        </ComboBox> -->
                        <CheckBox x:Name="ShowAllParametersCheckBox" Content="Show all Parameters" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- DataGrid row -->
                    <DataGrid x:Name="ParameterDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              Margin="5"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Width="30" Binding="{Binding IsSelected}"/>
                            <DataGridTextColumn Header="Parameter Name" Width="*" Binding="{Binding Name}"/>
                            <!-- <DataGridTemplateColumn Header="Parameter Type" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ParameterType}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding ParameterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140">
                                            <ComboBoxItem Content="Project Parameter"/>
                                            <ComboBoxItem Content="Shared Parameter"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn> -->
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <ComboBox x:Name="ParameterTypeHeaderComboBox"
                                                Width="140"
                                                SelectionChanged="ParameterTypeHeaderComboBox_SelectionChanged"
                                                SelectedIndex="0">
                                            <ComboBoxItem Content="All"/>
                                            <ComboBoxItem Content="Project Parameter"/>
                                            <ComboBoxItem Content="Shared Parameter"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ParameterType}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding ParameterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140">
                                            <ComboBoxItem Content="Project Parameter"/>
                                            <ComboBoxItem Content="Shared Parameter"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>


                            <DataGridTemplateColumn Header="Discipline" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Discipline}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding Discipline, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140">
                                            <ComboBoxItem Content="Common"/>
                                            <ComboBoxItem Content="Electrical"/>
                                            <ComboBoxItem Content="Energy"/>
                                            <ComboBoxItem Content="HVAC"/>
                                            <ComboBoxItem Content="Infrastructure"/>
                                            <ComboBoxItem Content="Piping"/>
                                            <ComboBoxItem Content="Structural"/>
                                            
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Group Under" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding GroupUnder}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding GroupUnder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140">
                                            <ComboBoxItem Content="Analysis Results"/>
                                            <ComboBoxItem Content="Analytical Alignment"/>
                                            <ComboBoxItem Content="Analytical Model"/>
                                            <ComboBoxItem Content="Constraints"/>
                                            <ComboBoxItem Content="Construction"/>
                                            <ComboBoxItem Content="Data"/>
                                            <ComboBoxItem Content="Dimensions"/>
                                            <ComboBoxItem Content="Division Geometry"/>
                                            <ComboBoxItem Content="Electrical"/>
                                            <ComboBoxItem Content="Electrical - Circuiting"/>
                                            <ComboBoxItem Content="Electrical - Lighting"/>
                                            <ComboBoxItem Content="Electrical - Loads"/>
                                            <ComboBoxItem Content="Electrical Analysis"/>
                                            <ComboBoxItem Content="Electrical Engineering"/>
                                            <ComboBoxItem Content="Energy Analysis"/>
                                            <ComboBoxItem Content="Fire Protection"/>
                                            <ComboBoxItem Content="Forces"/>
                                            <ComboBoxItem Content="General"/>
                                            <ComboBoxItem Content="Graphics"/>
                                            <ComboBoxItem Content="Green Building Properties"/>
                                            <ComboBoxItem Content="Identity Data"/>
                                            <ComboBoxItem Content="IFC Parameters"/>
                                            <ComboBoxItem Content="Layers"/>
                                            <ComboBoxItem Content="Life Safety"/>
                                            <ComboBoxItem Content="Materials and Finishes"/>
                                            <ComboBoxItem Content="Mechanical"/>
                                            <ComboBoxItem Content="Mechanical - Flow"/>  
                                            <ComboBoxItem Content="Mechanical - Loads"/>
                                            <ComboBoxItem Content="Model Properties"/> 
                                            <ComboBoxItem Content="Moments"/>
                                            <ComboBoxItem Content="Other"/>
                                            <ComboBoxItem Content="Overall Legend"/>
                                            <ComboBoxItem Content="Phasing"/>
                                            <ComboBoxItem Content="Photometrics"/>
                                            <ComboBoxItem Content="Plumbing"/>
                                            <ComboBoxItem Content="Rebar Set"/>
                                            <ComboBoxItem Content="Releases / Member Forces"/>
                                            <ComboBoxItem Content="Secondary End"/>
                                            <ComboBoxItem Content="Segments and Fittings"/>
                                            <ComboBoxItem Content="Set"/>
                                            <ComboBoxItem Content="Slab Shape Edit"/>
                                            <ComboBoxItem Content="Structural"/>
                                            <ComboBoxItem Content="Structural Analysis"/>
                                            <ComboBoxItem Content="Text"/>
                                            <ComboBoxItem Content="Title Text"/>
                                            <ComboBoxItem Content="Visibility"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Instance/Type" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding InstanceOrType}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding InstanceOrType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110">
                                            <ComboBoxItem Content="Instance"/>
                                            <ComboBoxItem Content="Type"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Categories"/>
        </TabControl>
    </Grid>
</Window>